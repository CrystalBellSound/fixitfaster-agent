# Copy to .env.local and fill in your keys.
# Required: Datadog API Key (Organization Settings → API Keys)
DATADOG_API_KEY=your_api_key_here

# Required for pipeline:setup (Application Keys)
DATADOG_APP_KEY=your_app_key_here

# EU or other site (default: datadoghq.com)
DATADOG_SITE=datadoghq.com
# DATADOG_SITE=datadoghq.eu

# when running the app locally and sending traces to this agent
DD_AGENT_HOST=localhost

# Fix It Faster app URL (enables auto-push of artifacts for browser-based submit)
FIXITFASTER_URL=https://dd-tse-fix-it-faster.vercel.app
