{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open Fix It Faster",
      "type": "shell",
      "command": "echo",
      "args": ["Ready"],
      "options": {
        "env": {
          "_trigger": "${input:openSimpleBrowser}"
        }
      },
      "runOptions": { "runOn": "folderOpen" },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "Fix It Faster - Agent Server",
      "type": "shell",
      "command": "node artifact-server.js",
      "runOptions": { "runOn": "folderOpen" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false }
    }
  ],
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["__BROWSER_URL__"]
    }
  ]
}
